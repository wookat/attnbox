{
  "name": "attnbox",
  "version": "0.3.3",
  "description": "Unified attention inbox for local CLI + cloud AI coding agents — see which agent is waiting on you.",
  "type": "module",
  "bin": {
    "attnbox": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "web-dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "attnbox-core": "workspace:*",
    "attnbox-collectors": "workspace:*",
    "attnbox-daemon": "workspace:*"
  },
  "devDependencies": {
    "@attnbox/web": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wookat/attnbox.git"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "devin",
    "inbox",
    "dashboard",
    "attention"
  ]
}
